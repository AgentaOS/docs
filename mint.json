{
  "$schema": "https://mintlify.com/schema.json",
  "name": "AgentaOS",
  "openapi": "openapi.json",
  "logo": {
    "dark": "/images/agentaos-icon.png",
    "light": "/images/agentaos-icon.png",
    "href": "https://agentaos.ai"
  },
  "favicon": "/images/agentaos-icon.png",
  "colors": {
    "primary": "#4F46E5",
    "light": "#6366F1",
    "dark": "#4338CA",
    "background": {
      "light": "#FFFFFF",
      "dark": "#0B1533"
    },
    "anchors": {
      "from": "#4F46E5",
      "to": "#12B981"
    }
  },
  "font": {
    "headings": { "family": "Bricolage Grotesque" },
    "body": { "family": "Inter" }
  },
  "sidebar": {
    "items": "border"
  },
  "rounded": "default",
  "css": "/custom.css",
  "modeToggle": {
    "default": "light"
  },
  "search": {
    "prompt": "Search docs..."
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
