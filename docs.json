  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1533"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://agentaos.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Log in",
      "href": "https://app.agentaos.ai"
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
  "footer": {
    "socials": {
      "github": "https://github.com/AgentaOS/agentaos",
      "x": "https://x.com/agentaos",
      "linkedin": "https://linkedin.com/company/agentaos"
    }
